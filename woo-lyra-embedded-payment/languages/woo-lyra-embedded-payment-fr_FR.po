msgid "REST API Notification URL"
msgstr "URL de notification de l'API REST"

#: class-wc-gateway-lyra-embedded.php:72
#, php-format
msgid "URL to copy into your %s Back Office > Settings > Notification rules. In multistore mode, notification URL is the same for all the stores."
msgstr ""
"URL à copier dans votre Back Office %s > Paramètres > Règles de notification. En mode multiboutique, l'URL de notification est la même pour toutes "
"les boutiques."

