msgstr "Reembolso en línea de %1$s - Motivo: %2$s."

#: includes/LyraEmbeddedSubscriptionProcessor.php:43
msgid "Private key is not configured. Subscription renewal cannot be processed."
msgstr "La clave privada no está configurada. La renovación de la suscripción no puede procesarse."

#: includes/LyraEmbeddedSubscriptionProcessor.php:58
msgid "Customer has no valid identifier. Subscription renewal cannot be processed."
msgstr "El cliente no tiene un identificador válido. La renovación de la suscripción no puede procesarse."

#: includes/LyraEmbeddedSubscriptionProcessor.php:74
#, php-format
msgid "An error has occurred during the renewal of the subscription. Please consult the %s logs for more details."
msgstr "Se ha producido un error durante la renovación de la suscripción. Consulte los registros de %s para obtener más detalles."

